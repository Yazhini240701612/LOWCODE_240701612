					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Staff_Directory_Report
		{
			displayName = "Staff Directory"
			show all rows from Staff_Directory    
			(
				Staff_Name as "Name"
				Staff_Role as "Role"
				Team
				Staff_Email as "Email"
				Phone
				Specialisation
				Staff_Status as "Status"
			)
		}
		default list Campus_Building_Report
		{
			displayName = "Building Scorecard"
			show all rows from Campus_Building    
			(
