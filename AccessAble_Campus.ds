		form Staff_Directory
		{
			displayname = "Staff Directory"
			success message = "Staff member saved"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Staff_Name
			(
    			type = text
				displayname = "Staff Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Staff_Email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Team
			(
				type = picklist
				values = {"Accessibility Cell","Civil Maintenance","Electrical","Lift Maintenance","Housekeeping","Transport","IT Services"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Staff_Role
			(
				type = picklist
				displayname = "Role"
				values = {"Accessibility Administrator","Auditor","Facilities Staff","Verifier"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Specialisation
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Staff_Status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Inactive"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
