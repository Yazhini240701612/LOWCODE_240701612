			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Header'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '22px'\n\tbgColor = '#6A1B9A'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '12px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#FFFFFF'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'SEE A BARRIER? REPORT IT.'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '6px'\n\tcolor = '#F3E5F5'\n\tsize = '14px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Blocked ramp, broken lift, missing handrail, damaged path? Tell us in under a minute - the Accessibility Cell is alerted instantly.'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '4px'\n\tcolor = '#E1BEE7'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'You get an email with your reference number, and another when the barrier is fixed.'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='KPI Reported'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '18px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#6A1B9A'\n    borderWidth = '2px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '10px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#5B6475'\n\tsize = '13px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'BARRIERS REPORTED'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '4px'\n\tcolor = '#6A1B9A'\n\tsize = '34px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.Barrier_Report.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '2px'\n\tcolor = '#8A93A6'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'By the campus community'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='33%'\n   \t>\n\t<panel elementName='KPI Fixed'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '18px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#2E7D32'\n    borderWidth = '2px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '10px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#5B6475'\n\tsize = '13px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'BARRIERS FIXED'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '4px'\n\tcolor = '#2E7D32'\n\tsize = '34px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Status == &quot;Closed&quot;'\n\t  value = 'thisapp.Barrier_Report.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '2px'\n\tcolor = '#8A93A6'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Verified and closed'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='34%'\n   \t>\n\t<panel elementName='KPI Progress'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '18px'\n\tbgColor = '#FFFFFF'\n\n    borderColor = '#EF6C00'\n    borderWidth = '2px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '10px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#5B6475'\n\tsize = '13px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'BEING WORKED ON'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '4px'\n\tcolor = '#EF6C00'\n\tsize = '34px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t\tcriteria = 'Status != &quot;Closed&quot; &amp;&amp; Status != &quot;Rejected&quot;'\n\t  value = 'thisapp.Barrier_Report.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '2px'\n\tcolor = '#8A93A6'\n\tsize = '12px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Under review or in progress'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Title Form'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '6px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#4A148C'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Report a Barrier'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Report Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Barrier_Report'\n\tzc_Header = 'false'\n/> \n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Title Track'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '6px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#4A148C'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Track Reports'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Track Reports'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Barrier_Reports'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '600'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void computeAuditScore(int aId)
                 {
                 	a = Accessibility_Audit[ID == aId];
                 	if(a.count() > 0)
                 	{
                 		vals = List();
                 		vals.add(ifnull(a.Ramp_Access,"N/A"));
                 		vals.add(ifnull(a.Pathway_Clear,"N/A"));
                 		vals.add(ifnull(a.Signage_Present,"N/A"));
                 		vals.add(ifnull(a.Lift_Operational,"N/A"));
                 		vals.add(ifnull(a.Restroom_Accessible,"N/A"));
                 		vals.add(ifnull(a.Parking_Usable,"N/A"));
                 		vals.add(ifnull(a.Handrails_Present,"N/A"));
                 		vals.add(ifnull(a.Tactile_Paving,"N/A"));
                 		pts = 0.0;
                 		applicable = 0;
                 		failed = 0;
                 		for each  v in vals
                 		{
                 			if(v == "Meets")
                 			{
                 				pts = pts + 1;
                 				applicable = applicable + 1;
                 			}
                 			else if(v == "Needs Improvement")
                 			{
                 				pts = pts + 0.5;
                 				applicable = applicable + 1;
                 			}
                 			else if(v == "Does Not Meet")
                 			{
                 				applicable = applicable + 1;
                 				failed = failed + 1;
                 			}
                 		}
                 		score = 0.0;
                 		if(applicable > 0)
                 		{
                 			score = (pts / applicable * 100).round(1);
                 		}
                 		a.Audit_Score=score;
                 		a.Failed_Items=failed;
                 		a.Overall_Result=if(score >= 80,"Accessible",if(score >= 50,"Partially Accessible","Not Accessible"));
                 		if(isBlank(a.Audit_Reference))
                 		{
                 			seq = Accessibility_Audit[ID <= aId].count();
                 			a.Audit_Reference="AUD-" + a.Audit_Date.getYear() + "-" + ("0000" + seq).right(4);
                 		}
                 		f = Campus_Facility[ID == a.Facility];
                 		if(f.count() > 0)
                 		{
                 			f.Next_Inspection_Due=a.Audit_Date.addDay(if(score >= 80,180,if(score >= 50,90,30)));
                 			thisapp.refreshBuilding(f.Campus_Building);
                 		}
                 	}
                 }
				 void escalateOverdue()
                 {
                 	today = zoho.currentdate;
                 	lines = List();
                 	cnt = 0;
                 	for each  r in Barrier_Report[Status != "Closed" && Status != "Rejected" && Target_Date < today]
                 	{
                 		lvl = ifnull(r.Escalation_Level,0) + 1;
                 		r.Escalation_Level=lvl;
                 		daysLate = daysBetween(r.Target_Date,today);
                 		bName = ifnull(Campus_Building[ID == r.Building].Building_Name,"Campus");
                 		lines.add(r.Report_Reference + " - " + r.Barrier_Type + " at " + bName + " (" + r.Priority + ", " + daysLate + " day(s) overdue, level " + lvl + ")");
                 		cnt = cnt + 1;
                 		for each  c in Corrective_Action[Barrier_Report == r.ID && Progress != "Completed"]
                 		{
                 			c.Is_Overdue="Yes";
                 		}
                 	}
                 	for each  c2 in Corrective_Action[Progress == "Completed"]
                 	{
                 		c2.Is_Overdue="No";
                 	}
                 	// Facilities due for re-inspection
                 	dueF = Campus_Facility[Next_Inspection_Due <= today.addDay(7)].count();
                 	if(cnt > 0)
                 	{
                 		msg = "ESCALATION - " + cnt + " accessibility barrier(s) are past their target date:\n- " + lines.toString("\n- ");
                 		if(dueF > 0)
                 		{
                 			msg = msg + "\n" + dueF + " facility/facilities due for re-inspection within 7 days.";
                 		}
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts",msg,"zoho_cliq_connection");
                 			info resp;
                 		}		catch (e)
                 		{
                 			info e;
                 		}
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :zoho.adminuserid
                 			subject :"AccessAble Campus - Daily escalation: " + cnt + " overdue barrier(s)"
                 			message :"<p>The following accessibility barriers are overdue and have been escalated:</p><ul><li>" + lines.toString("</li><li>") + "</li></ul><p>" + dueF + " facility/facilities are due for re-inspection within 7 days.</p>"
                 		]
                 	}
                 	for each  b in Campus_Building[ID != 0]
                 	{
                 		thisapp.refreshBuilding(b.ID);
                 	}
                 	info cnt + " overdue barrier(s) escalated";
                 }
				 void handleActionUpdate(int cId)
                 {
                 	c = Corrective_Action[ID == cId];
                 	if(c.count() == 0)
                 	{
                 		return;
                 	}
                 	r = Barrier_Report[ID == c.Barrier_Report];
                 	if(r.count() == 0)
                 	{
                 		return;
                 	}
                 	today = zoho.currentdate;
                 	if(isBlank(c.Action_Reference))
                 	{
                 		c.Action_Reference=r.Report_Reference.replaceAll("ACB-","ACT-");
                 	}
                 	if(c.Assigned_On == null)
                 	{
                 		c.Assigned_On=today;
                 	}
                 	if(c.Target_Date == null)
                 	{
                 		c.Target_Date=r.Target_Date;
                 	}
                 	c.Is_Overdue=if(c.Progress != "Completed" && c.Target_Date != null && c.Target_Date < today,"Yes","No");
                 	bName = ifnull(Campus_Building[ID == r.Building].Building_Name,"Campus");
                 	if(c.Verification_Result == "Accepted")
                 	{
                 		if(c.Verified_On == null)
                 		{
                 			c.Verified_On=today;
                 		}
                 		c.Progress="Completed";
                 		c.Is_Overdue="No";
                 		r.Status="Verified";
                 		r.Closed_On=c.Verified_On;
                 		thisapp.handleBarrierStatus(r.ID);
                 	}
                 	else if(c.Verification_Result == "Rework Required")
                 	{
                 		r.Status="Rework Required";
                 		c.Progress="In Progress";
                 		c.Verification_Result="Pending";
                 		stf = Staff_Directory[ID == c.Assigned_To];
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts","Rework required: " + c.Action_Reference + " (" + r.Barrier_Type + " at " + bName + ") was not accepted by the verifier. Comment: " + ifnull(c.Verification_Comments,"-"),"zoho_cliq_connection");
                 		}		catch (e)
                 		{
                 			info e;
                 		}
                 		if(stf.count() > 0)
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :stf.Staff_Email
                 				subject :"AccessAble Campus - Rework required on " + c.Action_Reference
                 				message :"<p>The verifier has asked for rework on " + c.Action_Reference + " (" + r.Barrier_Type + " at " + bName + ").</p><p><b>Comments:</b> " + ifnull(c.Verification_Comments,"-") + "</p>"
                 			]
                 		}
                 	}
                 	else if(c.Progress == "Completed")
                 	{
                 		r.Status="Awaiting Verification";
                 		ver = Staff_Directory[ID == c.Verifier];
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts","Ready for verification: " + c.Action_Reference + " (" + r.Barrier_Type + " at " + bName + "). Action taken: " + ifnull(c.Action_Taken,"-"),"zoho_cliq_connection");
                 		}		catch (e)
                 		{
                 			info e;
                 		}
                 		if(ver.count() > 0)
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :ver.Staff_Email
                 				subject :"AccessAble Campus - Please verify " + c.Action_Reference
                 				message :"<p>Work on " + c.Action_Reference + " (" + r.Barrier_Type + " at " + bName + ") is marked complete.</p><p><b>Action taken:</b> " + ifnull(c.Action_Taken,"-") + "</p><p>Please inspect and record the verification result.</p>"
                 			]
                 		}
                 	}
                 	else if(c.Progress == "In Progress")
                 	{
                 		r.Status="Work in Progress";
                 	}
                 	else
                 	{
                 		if(r.Status == "Approved" || r.Status == "Under Review" || r.Status == "Submitted")
                 		{
                 			r.Status="Assigned";
                 		}
                 	}
                 	thisapp.refreshBuilding(r.Building);
                 }
				 void handleAudit(int aId)
                 {
                 	thisapp.computeAuditScore(aId);
                 	a = Accessibility_Audit[ID == aId];
                 	if(a.count() == 0)
                 	{
                 		return;
                 	}
                 	f = Campus_Facility[ID == a.Facility];
                 	if(f.count() == 0)
                 	{
                 		return;
                 	}
                 	aud = Staff_Directory[ID == a.Auditor];
                 	// map checklist item -> (value, barrier type, priority)
                 	items = List();
                 	items.add({"v":a.Ramp_Access,"t":"Blocked Ramp","p":"High","l":"Ramp not available / obstructed"});
                 	items.add({"v":a.Pathway_Clear,"t":"Obstructed Pathway","p":"Medium","l":"Pathway not clear or level"});
                 	items.add({"v":a.Signage_Present,"t":"Missing Signage","p":"Low","l":"Accessibility signage missing"});
                 	items.add({"v":a.Lift_Operational,"t":"Lift Out of Service","p":"High","l":"Lift not operational"});
                 	items.add({"v":a.Restroom_Accessible,"t":"Inaccessible Restroom","p":"High","l":"Accessible restroom unavailable"});
                 	items.add({"v":a.Parking_Usable,"t":"Parking Misuse","p":"Medium","l":"Accessible parking not usable"});
                 	items.add({"v":a.Handrails_Present,"t":"Missing Handrail","p":"High","l":"Handrails missing on stairs/ramp"});
                 	items.add({"v":a.Tactile_Paving,"t":"Damaged Tactile Paving","p":"Medium","l":"Tactile paving damaged"});
                 	created = 0;
                 	for each  it in items
                 	{
                 		if(it.get("v") == "Does Not Meet")
                 		{
                 			existing = Barrier_Report[Facility == f.ID && Barrier_Type == it.get("t") && Status != "Closed" && Status != "Rejected"].count();
                 			if(existing == 0)
                 			{
                 				nid = insert into Barrier_Report
                 				[
                 					Added_User=zoho.loginuser
                 					Reporter_Name=ifnull(aud.Staff_Name,"Auditor")
                 					Reporter_Email=ifnull(aud.Staff_Email,zoho.adminuserid)
                 					Reporter_Type="Staff"
                 					Building=f.Campus_Building
                 					Facility=f.ID
                 					Barrier_Type=it.get("t")
                 					Description="Audit finding (" + ifnull(a.Audit_Reference,"audit") + "): " + it.get("l") + " at " + f.Facility_Name + ". " + ifnull(a.Observations,"")
                 					Priority=it.get("p")
                 					Status="Approved"
                 					Source="Audit Finding"
                 					Reported_On=a.Audit_Date
                 				];
                 				thisapp.processBarrierReport(nid);
                 				thisapp.handleBarrierStatus(nid);
                 				created = created + 1;
                 			}
                 		}
                 	}
                 	// Notify reviewer on Cliq if facility is poorly rated
                 	if(ifnull(a.Audit_Score,100) < 50 || created > 0)
                 	{
                 		msg = "Audit " + a.Audit_Reference + " submitted for " + f.Facility_Name + " | Score " + a.Audit_Score + "% (" + a.Overall_Result + ") | " + created + " new barrier(s) raised automatically. Please review.";
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts",msg,"zoho_cliq_connection");
                 			info resp;
                 		}		catch (e)
                 		{
                 			info e;
                 		}
                 	}
                 	a.Audit_Status="Submitted";
                 }
				 void handleBarrierStatus(int rId)
                 {
                 	r = Barrier_Report[ID == rId];
                 	if(r.count() == 0)
                 	{
                 		return;
                 	}
                 	today = zoho.currentdate;
                 	bName = ifnull(Campus_Building[ID == r.Building].Building_Name,"Campus");
                 	st = r.Status;
                 	// Approved -> auto-create and auto-route a corrective action to the right team
                 	if(st == "Approved")
                 	{
                 		if(Corrective_Action[Barrier_Report == rId].count() == 0)
                 		{
                 			team = "Civil Maintenance";
                 			if(r.Barrier_Type == "Lift Out of Service")
                 			{
                 				team = "Lift Maintenance";
                 			}
                 			else if(r.Barrier_Type == "Transport Boarding Issue")
                 			{
                 				team = "Transport";
                 			}
                 			else if(r.Barrier_Type == "Missing Signage" || r.Barrier_Type == "Inaccessible Restroom")
                 			{
                 				team = "Civil Maintenance";
                 			}
                 			stf = Staff_Directory[Team == team && Staff_Role == "Facilities Staff" && Staff_Status == "Active"] range from 1 to 1;
                 			if(stf.count() == 0)
                 			{
                 				stf = Staff_Directory[Staff_Role == "Facilities Staff" && Staff_Status == "Active"] range from 1 to 1;
                 			}
                 			ver = Staff_Directory[Staff_Role == "Verifier" && Staff_Status == "Active"] range from 1 to 1;
                 			if(stf.count() > 0)
                 			{
                 				insert into Corrective_Action
                 				[
                 					Added_User=zoho.loginuser
                 					Action_Reference=r.Report_Reference.replaceAll("ACB-","ACT-")
                 					Barrier_Report=rId
                 					Assigned_To=stf.ID
                 					Assigned_On=today
                 					Target_Date=r.Target_Date
                 					Work_Instructions="Resolve " + r.Barrier_Type + " at " + bName + ". " + ifnull(r.Description,"")
                 					Progress="Not Started"
                 					Verifier=if(ver.count() > 0,ver.ID,null)
                 					Verification_Result="Pending"
                 					Is_Overdue="No"
                 				]
                 				r.Status="Assigned";
                 				msg = "Assigned: " + r.Report_Reference + " (" + r.Priority + " - " + r.Barrier_Type + " at " + bName + ") assigned to " + stf.Staff_Name + " [" + team + "]. Due " + r.Target_Date.toString("dd-MMM-yyyy");
                 				try 
                 				{
                 					resp = zoho.cliq.postToChannel("accessalerts",msg,"zoho_cliq_connection");
                 				}				catch (e)
                 				{
                 					info e;
                 				}
                 				sendmail
                 				[
                 					from :zoho.adminuserid
                 					to :stf.Staff_Email
                 					subject :"AccessAble Campus - New corrective action " + r.Report_Reference
                 					message :"<p>Dear " + stf.Staff_Name + ",</p><p>A new accessibility barrier has been assigned to you.</p><p><b>Reference:</b> " + r.Report_Reference + "<br><b>Barrier:</b> " + r.Barrier_Type + " at " + bName + "<br><b>Priority:</b> " + r.Priority + "<br><b>Due:</b> " + r.Target_Date.toString("dd-MMM-yyyy") + "</p><p>" + ifnull(r.Description,"") + "</p><p>Please update progress in AccessAble Campus.</p>"
                 				]
                 			}
                 		}
                 	}
                 	// Rejected -> inform reporter
                 	if(st == "Rejected" && !isBlank(r.Reporter_Email))
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :r.Reporter_Email
                 			subject :"AccessAble Campus - Report " + r.Report_Reference + " reviewed"
                 			message :"<p>Dear " + r.Reporter_Name + ",</p><p>Your report " + r.Report_Reference + " was reviewed and closed without action (duplicate or not an accessibility barrier). Please contact the Accessibility Cell if the problem persists.</p>"
                 		]
                 	}
                 	// Closed -> resolution metrics + closure email
                 	if(st == "Closed" || st == "Verified")
                 	{
                 		if(r.Closed_On == null)
                 		{
                 			r.Closed_On=today;
                 		}
                 		r.Days_To_Resolve=daysBetween(r.Reported_On,r.Closed_On);
                 		r.Status="Closed";
                 		if(!isBlank(r.Reporter_Email))
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :r.Reporter_Email
                 				subject :"Barrier Closure Certificate - " + r.Report_Reference
                 				message :"<div style='max-width:620px;margin:auto;border:6px double #1E2A5A;padding:28px;font-family:Georgia,serif;text-align:center'><div style='font-size:13px;letter-spacing:3px;color:#5B6475'>ACCESSABLE CAMPUS</div><h1 style='color:#1E2A5A;margin:8px 0'>Barrier Closure Certificate</h1><p style='font-size:15px'>This certifies that the accessibility barrier reported by <b>" + r.Reporter_Name + "</b> has been resolved and verified.</p><table style='margin:16px auto;font-size:14px;text-align:left'><tr><td><b>Reference</b></td><td>" + r.Report_Reference + "</td></tr><tr><td><b>Barrier</b></td><td>" + r.Barrier_Type + "</td></tr><tr><td><b>Location</b></td><td>" + bName + "</td></tr><tr><td><b>Priority</b></td><td>" + r.Priority + "</td></tr><tr><td><b>Reported on</b></td><td>" + r.Reported_On.toString("dd-MMM-yyyy") + "</td></tr><tr><td><b>Closed on</b></td><td>" + r.Closed_On.toString("dd-MMM-yyyy") + "</td></tr><tr><td><b>Resolved in</b></td><td>" + r.Days_To_Resolve + " day(s)</td></tr></table><p style='font-size:13px;color:#5B6475'>Thank you for helping make our campus accessible for everyone.</p><p style='font-size:12px;color:#8A93A6'>Accessibility Cell - AccessAble Campus</p></div>"
                 			]
                 		}
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts","Resolved: " + r.Report_Reference + " (" + r.Barrier_Type + " at " + bName + ") closed in " + r.Days_To_Resolve + " day(s).","zoho_cliq_connection");
                 		}		catch (e)
                 		{
                 			info e;
                 		}
                 	}
                 	thisapp.refreshBuilding(r.Building);
                 }
				 void loadSampleData()
                 {
                 	if(Campus_Building[ID != 0].count() > 0)
                 	{
                 		info "Data already loaded - skipped";
                 		return;
                 	}
                 	em = zoho.adminuserid;
                 	today = zoho.currentdate;
                 	// ---------- Staff ----------
                 	staff = List();
                 	staff.add({"k":"ADMIN","n":"Dr. Meena Raghavan","r":"Accessibility Administrator","t":"Accessibility Cell","s":"Campus accessibility coordinator"});
                 	staff.add({"k":"AUD1","n":"Arun Kumar","r":"Auditor","t":"Accessibility Cell","s":"Building access audits"});
                 	staff.add({"k":"AUD2","n":"Priya Sundar","r":"Auditor","t":"Accessibility Cell","s":"Restroom and signage audits"});
                 	staff.add({"k":"CIV","n":"Ravi Shankar","r":"Facilities Staff","t":"Civil Maintenance","s":"Ramps, pathways, handrails"});
                 	staff.add({"k":"LIFT","n":"Suresh Mani","r":"Facilities Staff","t":"Lift Maintenance","s":"Lift servicing"});
                 	staff.add({"k":"TRN","n":"Mohan Das","r":"Facilities Staff","t":"Transport","s":"College bus fleet"});
                 	staff.add({"k":"VER","n":"Kavitha Nair","r":"Verifier","t":"Accessibility Cell","s":"Work verification"});
                 	sId = Map();
                 	for each  s in staff
                 	{
                 		nid = insert into Staff_Directory
                 		[
                 			Added_User=zoho.loginuser
                 			Staff_Name=s.get("n")
                 			Staff_Email=em
                 			Staff_Role=s.get("r")
                 			Team=s.get("t")
                 			Specialisation=s.get("s")
                 			Staff_Status="Active"
                 		];
                 		sId.put(s.get("k"),nid);
                 	}
                 	// ---------- Buildings ----------
                 	blds = List();
                 	blds.add({"c":"ADM","n":"Admin Block","t":"Administrative","f":3});
                 	blds.add({"c":"WSB","n":"Workshop Block","t":"Academic","f":2});
                 	blds.add({"c":"LIB","n":"Library","t":"Library","f":2});
                 	blds.add({"c":"HUT","n":"Hut Cafe","t":"Cafeteria","f":1});
                 	blds.add({"c":"RCF","n":"REC Cafe","t":"Cafeteria","f":1});
                 	blds.add({"c":"IDF","n":"Idea Factory","t":"Innovation","f":2});
                 	blds.add({"c":"TLG","n":"Tech Lounge","t":"Recreation","f":1});
                 	blds.add({"c":"CBL","n":"C Block","t":"Academic","f":4});
                 	blds.add({"c":"ACB","n":"Academic Block","t":"Academic","f":5});
                 	blds.add({"c":"LBB","n":"Library Block","t":"Library","f":3});
                 	blds.add({"c":"BBC","n":"BB Court","t":"Sports","f":0});
                 	blds.add({"c":"BUS","n":"Bus Bay (Transport)","t":"Transport","f":0});
                 	bId = Map();
                 	for each  b in blds
                 	{
                 		nid = insert into Campus_Building
                 		[
                 			Added_User=zoho.loginuser
                 			Building_Name=b.get("n")
                 			Building_Code=b.get("c")
                 			Building_Type=b.get("t")
                 			Floors=b.get("f")
                 			Rating="Not Audited"
                 			Open_Barriers=0
                 			Building_Status="Active"
                 		];
                 		bId.put(b.get("c"),nid);
                 	}
                 	// ---------- Facilities ----------
                 	facs = List();
                 	facs.add({"k":"ADM-RAMP","b":"ADM","n":"Admin Main Entrance Ramp","t":"Ramp","fl":"Ground"});
                 	facs.add({"k":"ADM-LIFT","b":"ADM","n":"Admin Block Lift","t":"Lift","fl":"Ground"});
                 	facs.add({"k":"ACB-LIFTA","b":"ACB","n":"Academic Block Lift A","t":"Lift","fl":"Ground"});
                 	facs.add({"k":"ACB-RR","b":"ACB","n":"Academic Block Accessible Restroom","t":"Restroom","fl":"Ground"});
                 	facs.add({"k":"ACB-ENT","b":"ACB","n":"Academic Block Main Entrance","t":"Entrance","fl":"Ground"});
                 	facs.add({"k":"LIB-STEPS","b":"LIB","n":"Library Front Steps","t":"Staircase","fl":"Ground"});
                 	facs.add({"k":"LBB-LIFT","b":"LBB","n":"Library Block Lift","t":"Lift","fl":"Ground"});
                 	facs.add({"k":"LBB-PARK","b":"LBB","n":"Library Block Accessible Parking","t":"Parking","fl":"Outdoor"});
                 	facs.add({"k":"WSB-PATH","b":"WSB","n":"Workshop Access Pathway","t":"Pathway","fl":"Outdoor"});
                 	facs.add({"k":"HUT-ENT","b":"HUT","n":"Hut Cafe Entrance","t":"Entrance","fl":"Ground"});
                 	facs.add({"k":"RCF-RR","b":"RCF","n":"REC Cafe Restroom","t":"Restroom","fl":"Ground"});
                 	facs.add({"k":"IDF-SIGN","b":"IDF","n":"Idea Factory Accessibility Signage","t":"Signage","fl":"Ground"});
                 	facs.add({"k":"TLG-RAMP","b":"TLG","n":"Tech Lounge Ramp","t":"Ramp","fl":"Ground"});
                 	facs.add({"k":"CBL-TACT","b":"CBL","n":"C Block Footpath Tactile Paving","t":"Tactile Paving","fl":"Outdoor"});
                 	facs.add({"k":"CBL-STAIR","b":"CBL","n":"C Block Main Staircase","t":"Staircase","fl":"All floors"});
                 	facs.add({"k":"BBC-PATH","b":"BBC","n":"BB Court Access Path","t":"Pathway","fl":"Outdoor"});
                 	facs.add({"k":"BUS-BOARD","b":"BUS","n":"College Bus Boarding Point","t":"Bus Boarding","fl":"Outdoor"});
                 	fId = Map();
                 	for each  f in facs
                 	{
                 		nid = insert into Campus_Facility
                 		[
                 			Added_User=zoho.loginuser
                 			Facility_Name=f.get("n")
                 			Campus_Building=bId.get(f.get("b"))
                 			Facility_Type=f.get("t")
                 			Floor=f.get("fl")
                 			Facility_Status="Operational"
                 		];
                 		fId.put(f.get("k"),nid);
                 	}
                 	// ---------- Audits ----------
                 	cm = {"M":"Meets","N":"Needs Improvement","D":"Does Not Meet","X":"N/A"};
                 	auds = List();
                 	auds.add({"f":"ACB-ENT","d":80,"a":"AUD1","c":"NNMXXMNM"});
                 	auds.add({"f":"ADM-RAMP","d":75,"a":"AUD1","c":"DMNXXMNM"});
                 	auds.add({"f":"ACB-LIFTA","d":70,"a":"AUD2","c":"MNMDXXMN"});
                 	auds.add({"f":"BBC-PATH","d":65,"a":"AUD1","c":"XDNXXXXN"});
                 	auds.add({"f":"HUT-ENT","d":60,"a":"AUD2","c":"DNDXXXNX"});
                 	auds.add({"f":"LIB-STEPS","d":55,"a":"AUD1","c":"XMNXXXDN"});
                 	auds.add({"f":"CBL-TACT","d":50,"a":"AUD2","c":"XNMXXXMD"});
                 	auds.add({"f":"RCF-RR","d":45,"a":"AUD2","c":"XNNXDXNX"});
                 	auds.add({"f":"ACB-RR","d":40,"a":"AUD1","c":"XMNXDXMX"});
                 	auds.add({"f":"LBB-LIFT","d":35,"a":"AUD2","c":"MMMNXMMM"});
                 	auds.add({"f":"IDF-SIGN","d":30,"a":"AUD1","c":"MMDXXXMM"});
                 	auds.add({"f":"WSB-PATH","d":28,"a":"AUD2","c":"XDNXXXNN"});
                 	auds.add({"f":"BUS-BOARD","d":25,"a":"AUD1","c":"XXNXXXDX"});
                 	auds.add({"f":"ADM-RAMP","d":20,"a":"AUD2","c":"MMMXXMMN"});
                 	auds.add({"f":"TLG-RAMP","d":18,"a":"AUD1","c":"NMMXXXMM"});
                 	auds.add({"f":"ACB-LIFTA","d":12,"a":"AUD2","c":"MMNDXXMM"});
                 	auds.add({"f":"CBL-STAIR","d":9,"a":"AUD1","c":"XMMXXXNM"});
                 	auds.add({"f":"LBB-PARK","d":5,"a":"AUD2","c":"MMMXXMMM"});
                 	for each  a in auds
                 	{
                 		c = a.get("c");
                 		nid = insert into Accessibility_Audit
                 		[
                 			Added_User=zoho.loginuser
                 			Facility=fId.get(a.get("f"))
                 			Auditor=sId.get(a.get("a"))
                 			Audit_Date=today.subDay(a.get("d"))
                 			Ramp_Access=cm.get(c.subString(0,1))
                 			Pathway_Clear=cm.get(c.subString(1,2))
                 			Signage_Present=cm.get(c.subString(2,3))
                 			Lift_Operational=cm.get(c.subString(3,4))
                 			Restroom_Accessible=cm.get(c.subString(4,5))
                 			Parking_Usable=cm.get(c.subString(5,6))
                 			Handrails_Present=cm.get(c.subString(6,7))
                 			Tactile_Paving=cm.get(c.subString(7,8))
                 			Observations="Routine accessibility inspection"
                 			Audit_Status="Reviewed"
                 		];
                 		thisapp.computeAuditScore(nid);
                 	}
                 	// ---------- Barrier reports ----------
                 	pDays = {"Critical":2,"High":5,"Medium":10,"Low":20};
                 	brs = List();
                 	brs.add({"b":"ACB","f":"ACB-LIFTA","t":"Lift Out of Service","p":"High","s":"Closed","d":50,"cd":47,"rn":"Karthik R","rt":"Student","st":"Disappointment","kw":"lift, not responding, stairs","w":"LIFT","desc":"Lift A in the Academic Block is not responding and students with mobility needs are forced to use the stairs."});
                 	brs.add({"b":"ADM","f":"ADM-RAMP","t":"Blocked Ramp","p":"High","s":"Closed","d":40,"cd":36,"rn":"Anitha S","rt":"Staff","st":"Anger","kw":"wheelchair ramp, blocked, motorbikes, entrance","w":"CIV","desc":"The wheelchair ramp at the Admin Block entrance is blocked by parked motorbikes during office hours."});
                 	brs.add({"b":"ACB","f":"ACB-LIFTA","t":"Lift Out of Service","p":"Critical","s":"Closed","d":30,"cd":28,"rn":"Divya P","rt":"Student","st":"Anger","kw":"lift, stopped, between floors","w":"LIFT","desc":"Lift A stopped working again between floors with two students inside for ten minutes."});
                 	brs.add({"b":"IDF","f":"IDF-SIGN","t":"Missing Signage","p":"Low","s":"Closed","d":25,"cd":15,"rn":"Visitor - Ramesh","rt":"Visitor","st":"Neutral","kw":"accessibility sign, faded, peeled","w":"CIV","desc":"The accessibility sign near the Idea Factory entrance is faded and partly peeled off."});
                 	brs.add({"b":"RCF","f":"RCF-RR","t":"Inaccessible Restroom","p":"High","s":"Rejected","d":20,"cd":-1,"rn":"Sneha M","rt":"Student","st":"Disappointment","kw":"restroom, narrow door, REC Cafe","w":"","desc":"No accessible restroom near REC Cafe, the door is too narrow for a wheelchair. (Duplicate of an existing audit finding)"});
                 	brs.add({"b":"LBB","f":"LBB-LIFT","t":"Lift Out of Service","p":"Medium","s":"Rework Required","d":15,"cd":-1,"rn":"Prof. Lakshmi","rt":"Staff","st":"Disappointment","kw":"lift buttons, floor 2, not working","w":"LIFT","desc":"Library Block lift call buttons on floor 2 are not working."});
                 	brs.add({"b":"BUS","f":"BUS-BOARD","t":"Transport Boarding Issue","p":"High","s":"Work in Progress","d":12,"cd":-1,"rn":"Arjun V","rt":"Student","st":"Disappointment","kw":"bus steps, high, grab rail, boarding","w":"TRN","desc":"College bus entrance steps are very high and there is no grab rail, making boarding difficult for students with crutches."});
                 	brs.add({"b":"CBL","f":"CBL-TACT","t":"Damaged Tactile Paving","p":"Medium","s":"Awaiting Verification","d":10,"cd":-1,"rn":"Nithya K","rt":"Student","st":"Neutral","kw":"tactile paving, cracked, missing tiles, footpath","w":"CIV","desc":"Tactile paving on the C Block footpath is cracked with several tiles missing."});
                 	brs.add({"b":"TLG","f":"TLG-RAMP","t":"Blocked Ramp","p":"Medium","s":"Closed","d":8,"cd":5,"rn":"Harish B","rt":"Student","st":"Anger","kw":"ramp, blocked, stacked chairs, Tech Lounge","w":"CIV","desc":"The ramp at the Tech Lounge is blocked by stacked chairs after an event."});
                 	brs.add({"b":"ACB","f":"ACB-LIFTA","t":"Lift Out of Service","p":"Critical","s":"Work in Progress","d":6,"cd":-1,"rn":"Meera J","rt":"Student","st":"Anger","kw":"Lift A, out of service, no notice","w":"LIFT","desc":"Lift A near the staircase has been out of service for three days with no notice board."});
                 	brs.add({"b":"LIB","f":"LIB-STEPS","t":"Missing Handrail","p":"High","s":"Assigned","d":4,"cd":-1,"rn":"Gokul S","rt":"Student","st":"Disappointment","kw":"library steps, no handrail, crutches","w":"CIV","desc":"Library entrance steps have no handrail, which is hard for students using crutches."});
                 	brs.add({"b":"BBC","f":"BBC-PATH","t":"Uneven Surface","p":"Medium","s":"Approved","d":3,"cd":-1,"rn":"Coach Vinod","rt":"Staff","st":"Neutral","kw":"pothole, path, BB court","w":"","desc":"The path to the BB court has a large pothole that a wheelchair cannot cross."});
                 	brs.add({"b":"WSB","f":"WSB-PATH","t":"Obstructed Pathway","p":"Medium","s":"Under Review","d":2,"cd":-1,"rn":"Sanjay T","rt":"Student","st":"Disappointment","kw":"pathway, sand bags, bricks, workshop","w":"","desc":"Construction sand bags and bricks are blocking the pathway to the Workshop Block."});
                 	brs.add({"b":"HUT","f":"HUT-ENT","t":"Uneven Surface","p":"Medium","s":"Submitted","d":1,"cd":-1,"rn":"Fathima Z","rt":"Student","st":"Disappointment","kw":"entrance, raised step, tables, wheelchair","w":"","desc":"Hut Cafe entrance has a raised step and tables placed so a wheelchair cannot pass."});
                 	seq = 0;
                 	liftCount = 0;
                 	for each  r in brs
                 	{
                 		seq = seq + 1;
                 		rep = today.subDay(r.get("d"));
                 		tgt = rep.addDay(pDays.get(r.get("p")));
                 		st = r.get("s");
                 		closedOn = null;
                 		dtr = null;
                 		if(r.get("cd") >= 0)
                 		{
                 			closedOn = today.subDay(r.get("cd"));
                 			dtr = r.get("d") - r.get("cd");
                 		}
                 		recurring = "No";
                 		rc = 0;
                 		if(r.get("f") == "ACB-LIFTA")
                 		{
                 			liftCount = liftCount + 1;
                 			rc = liftCount;
                 			if(liftCount >= 3)
                 			{
                 				recurring = "Yes";
                 			}
                 		}
                 		esc = 0;
                 		if(st != "Closed" && st != "Rejected" && tgt < today)
                 		{
                 			esc = 1;
                 		}
                 		rid = insert into Barrier_Report
                 		[
                 			Added_User=zoho.loginuser
                 			Report_Reference="ACB-" + rep.getYear() + "-" + ("0000" + seq).right(4)
                 			Reporter_Name=r.get("rn")
                 			Reporter_Email=em
                 			Reporter_Type=r.get("rt")
                 			Building=bId.get(r.get("b"))
                 			Facility=fId.get(r.get("f"))
                 			Barrier_Type=r.get("t")
                 			Description=r.get("desc")
                 			Priority=r.get("p")
                 			Status=st
                 			Source="Community Report"
                 			Reported_On=rep
                 			Target_Date=tgt
                 			Is_Recurring=recurring
                 			Recurrence_Count=rc
                 			AI_Keywords=r.get("kw")
                 			AI_Sentiment=r.get("st")
                 			Escalation_Level=esc
                 			Cliq_Status="Sample data"
                 			Closed_On=closedOn
                 			Days_To_Resolve=dtr
                 		];
                 		w = r.get("w");
                 		if(w != "")
                 		{
                 			prog = "In Progress";
                 			vres = "Pending";
                 			verOn = null;
                 			if(st == "Assigned")
                 			{
                 				prog = "Not Started";
                 			}
                 			if(st == "Awaiting Verification")
                 			{
                 				prog = "Completed";
                 			}
                 			if(st == "Rework Required")
                 			{
                 				prog = "Completed";
                 				vres = "Rework Required";
                 			}
                 			if(st == "Closed")
                 			{
                 				prog = "Completed";
                 				vres = "Accepted";
                 				verOn = closedOn;
                 			}
                 			overdue = if(esc > 0,"Yes","No");
                 			insert into Corrective_Action
                 			[
                 				Added_User=zoho.loginuser
                 				Action_Reference="ACT-" + rep.getYear() + "-" + ("0000" + seq).right(4)
                 				Barrier_Report=rid
                 				Assigned_To=sId.get(w)
                 				Assigned_On=rep.addDay(1)
                 				Target_Date=tgt
                 				Work_Instructions="Resolve: " + r.get("t")
                 				Progress=prog
                 				Action_Taken=if(prog == "Completed","Obstruction removed / repair completed","")
                 				Verifier=sId.get("VER")
                 				Verification_Result=vres
                 				Verified_On=verOn
                 				Is_Overdue=overdue
                 			]
                 		}
                 	}
                 	for each  bb in Campus_Building[ID != 0]
                 	{
                 		thisapp.refreshBuilding(bb.ID);
                 	}
                 	info "Sample data loaded";
                 }
				 void processBarrierReport(int rId)
                 {
                 	r = Barrier_Report[ID == rId];
                 	if(r.count() == 0)
                 	{
                 		return;
                 	}
                 	today = zoho.currentdate;
                 	// 1. Reference number and dates
                 	if(isBlank(r.Report_Reference))
                 	{
                 		seq = Barrier_Report[ID != 0].count();
                 		r.Report_Reference="ACB-" + today.getYear() + "-" + ("0000" + seq).right(4);
                 	}
                 	if(r.Reported_On == null)
                 	{
                 		r.Reported_On=today;
                 	}
                 	if(isBlank(r.Priority))
                 	{
                 		r.Priority="Medium";
                 	}
                 	// 2. Recurring barrier detection (same facility/building + same type in last 60 days)
                 	if(r.Facility != null)
                 	{
                 		similar = Barrier_Report[Facility == r.Facility && Barrier_Type == r.Barrier_Type && Reported_On >= today.subDay(60)].count();
                 	}
                 	else
                 	{
                 		similar = Barrier_Report[Building == r.Building && Barrier_Type == r.Barrier_Type && Reported_On >= today.subDay(60)].count();
                 	}
                 	r.Recurrence_Count=similar;
                 	if(similar >= 3)
                 	{
                 		r.Is_Recurring="Yes";
                 		if(r.Priority == "Low")
                 		{
                 			r.Priority="Medium";
                 		}
                 		else if(r.Priority == "Medium")
                 		{
                 			r.Priority="High";
                 		}
                 	}
                 	else
                 	{
                 		r.Is_Recurring="No";
                 	}
                 	// 3. Target date from priority (SLA)
                 	slaDays = {"Critical":2,"High":5,"Medium":10,"Low":20};
                 	r.Target_Date=r.Reported_On.addDay(slaDays.get(r.Priority));
                 	r.Escalation_Level=0;
                 	// 4. AI sentiment (Zia) - advisory only, never used to set priority
                 	desc = ifnull(r.Description,"");
                 	if(desc != "")
                 	{
                 		try 
                 		{
                 			sent = if(desc.length() > 190,desc.subString(0,190),desc);
                 			ai = zoho.ai.analyseSentiment(sent);
                 			emo = "";
                 			if(ai.containKey("data"))
                 			{
                 				emo = ai.get("data").get(0).get("Emotion");
                 			}
                 			else if(ai.containKey("Prediction"))
                 			{
                 				emo = ai.get("Prediction");
                 			}
                 			r.AI_Sentiment=ifnull(emo,"Unavailable");
                 		}		catch (e)
                 		{
                 			r.AI_Sentiment="Unavailable";
                 		}
                 		// 5. Keyword extraction (accessibility vocabulary match)
                 		vocab = {"wheelchair","ramp","lift","elevator","stairs","steps","handrail","railing","blocked","obstructed","parked","bike","construction","pothole","crack","broken","damaged","tactile","signage","sign","restroom","toilet","door","narrow","slippery","wet","spill","dark","lighting","bus","boarding","crutches","blind","visually impaired","hearing","entrance","pathway","path","parking","stuck","trapped","out of order","not working"};
                 		low = desc.toLowerCase();
                 		kw = List();
                 		for each  v in vocab
                 		{
                 			if(low.contains(v))
                 			{
                 				kw.add(v);
                 			}
                 		}
                 		r.AI_Keywords=if(kw.size() > 0,kw.toString(", "),"(none detected)");
                 	}
                 	// 6. Cliq alert for Critical / High / Recurring
                 	bName = ifnull(Campus_Building[ID == r.Building].Building_Name,"Campus");
                 	fName = "";
                 	if(r.Facility != null)
                 	{
                 		fName = " / " + Campus_Facility[ID == r.Facility].Facility_Name;
                 	}
                 	if(r.Priority == "Critical" || r.Priority == "High" || r.Is_Recurring == "Yes")
                 	{
                 		msg = if(r.Priority == "Critical","URGENT - ","") + "Accessibility barrier " + r.Report_Reference + " | " + r.Priority + " | " + r.Barrier_Type + " at " + bName + fName + " | Reported by " + r.Reporter_Name + " | Due " + r.Target_Date.toString("dd-MMM-yyyy");
                 		if(r.Is_Recurring == "Yes")
                 		{
                 			msg = msg + " | RECURRING (" + similar + " similar reports in 60 days)";
                 		}
                 		msg = msg + " | " + desc;
                 		try 
                 		{
                 			resp = zoho.cliq.postToChannel("accessalerts",msg,"zoho_cliq_connection");
                 			info resp;
                 			r.Cliq_Status=if(resp.get("status") == "OK","Posted","Failed");
                 		}		catch (e)
                 		{
                 			r.Cliq_Status="Failed";
                 		}
                 	}
                 	else
                 	{
                 		r.Cliq_Status="Not required (" + r.Priority + ")";
                 	}
                 	// 7. Email acknowledgement to reporter
                 	if(!isBlank(r.Reporter_Email))
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :r.Reporter_Email
                 			subject :"AccessAble Campus - Report " + r.Report_Reference + " received"
                 			message :"<p>Dear " + r.Reporter_Name + ",</p><p>Thank you for reporting an accessibility barrier. Your report has been recorded.</p><p><b>Reference:</b> " + r.Report_Reference + "<br><b>Location:</b> " + bName + fName + "<br><b>Barrier:</b> " + r.Barrier_Type + "<br><b>Priority:</b> " + r.Priority + "<br><b>Target resolution:</b> " + r.Target_Date.toString("dd-MMM-yyyy") + "</p><p>The Accessibility Cell will review it and keep you updated.</p><p>- AccessAble Campus</p>"
                 		]
                 	}
                 	thisapp.refreshBuilding(r.Building);
                 }
				 void refreshBuilding(int bId)
                 {
                 	b = Campus_Building[ID == bId];
                 	if(b.count() > 0)
                 	{
                 		openCount = Barrier_Report[Building == bId && Status != "Closed" && Status != "Rejected"].count();
                 		total = 0.0;
                 		cnt = 0;
                 		lastDate = '01-Jan-2000';
                 		for each  f in Campus_Facility[Campus_Building == bId]
                 		{
                 			la = Accessibility_Audit[Facility == f.ID] sort by Audit_Date desc range from 1 to 1;
                 			if(la.count() > 0)
                 			{
                 				if(la.Audit_Score != null)
                 				{
                 					total = total + la.Audit_Score;
                 					cnt = cnt + 1;
                 					if(la.Audit_Date > lastDate)
                 					{
                 						lastDate = la.Audit_Date;
                 					}
                 				}
                 			}
                 		}
                 		b.Open_Barriers=openCount;
                 		if(cnt > 0)
                 		{
                 			score = (total / cnt).round(1);
                 			b.Accessibility_Score=score;
                 			b.Last_Audit_Date=lastDate;
                 			b.Rating=if(score >= 80,"Green",if(score >= 50,"Amber","Red"));
                 		}
                 		else
                 		{
                 			b.Rating="Not Audited";
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			On_Audit_Submitted as "On Audit Submitted"
			{
				type =  form
				form = Accessibility_Audit

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.handleAudit(input.ID);
						)
					}
				}

			}
			On_Barrier_Reported as "On Barrier Reported"
			{
				type =  form
				form = Barrier_Report

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.processBarrierReport(input.ID);
										r = Barrier_Report[ID == input.ID];
										if(r.Source == "Audit Finding" && r.Status == "Approved")
										{
											thisapp.handleBarrierStatus(input.ID);
										}
						)
					}
				}

			}
			On_Barrier_Status_Change as "On Barrier Status Change"
			{
				type =  form
				form = Barrier_Report

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Runs whenever an administrator updates a barrier (approve / reject / close)
										thisapp.handleBarrierStatus(input.ID);
						)
					}
				}

			}
			On_Action_Progress as "On Action Progress"
			{
				type =  form
				form = Corrective_Action

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Syncs staff progress and verifier decision back to the barrier report
										thisapp.handleActionUpdate(input.ID);
						)
					}
				}

			}
			Report_Form_Load as "Report Form Load"
			{
				type =  form
				form = Barrier_Report

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Reporters only see the fields they need - system fields are filled automatically
										hide Report_Reference;
										hide Status;
										hide Source;
										hide Reported_On;
										hide Target_Date;
										hide Is_Recurring;
										hide Recurrence_Count;
										hide AI_Keywords;
										hide AI_Sentiment;
										hide Escalation_Level;
										hide Cliq_Status;
										hide Closed_On;
										hide Days_To_Resolve;
						)
					}
				}

			}
			Audit_Form_Load as "Audit Form Load"
			{
				type =  form
				form = Accessibility_Audit

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Score, result and reference are calculated automatically on submit
										input.Audit_Date = zoho.currentdate;
										hide Audit_Reference;
										hide Audit_Score;
										hide Overall_Result;
										hide Failed_Items;
										hide Audit_Status;
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Overdue_Escalation as "Daily Overdue Escalation"
			{
				type =  schedule
				start = "2026-10-31 08:30:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Every day at 08:30 - escalate overdue barriers to Cliq + email and refresh building scores
										thisapp.escalateOverdue();
					)
					}
				}
			}
		}




