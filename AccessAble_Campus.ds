 application "AccessAble Campus"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Accessibility_Audit
		{
			displayname = "Accessibility Audit"
			success message = "Audit submitted successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Audit_Reference
			(
    			type = text
				displayname = "Audit Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Facility
			(
				type = picklist	
				values  = Campus_Facility.ID
    			displayformat = [Facility_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Auditor
			(
				type = picklist	
				values  = Staff_Directory.ID
    			displayformat = [Staff_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Audit_Date
			(
    			type = date
				displayname = "Audit Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ramp_Access
			(
				type = radiobuttons
				displayname = "Ramp available and unobstructed"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pathway_Clear
			(
				type = radiobuttons
				displayname = "Pathway clear and level"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Signage_Present
			(
				type = radiobuttons
				displayname = "Accessibility signage present"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Lift_Operational
			(
				type = radiobuttons
				displayname = "Lift operational"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Restroom_Accessible
			(
				type = radiobuttons
				displayname = "Accessible restroom available"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Parking_Usable
			(
				type = radiobuttons
				displayname = "Accessible parking usable"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Handrails_Present
			(
				type = radiobuttons
				displayname = "Handrails on stairs and ramps"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tactile_Paving
			(
				type = radiobuttons
				displayname = "Tactile paving intact"
				values = {"Meets","Needs Improvement","Does Not Meet","N/A"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Audit_Score
			(
				type = decimal
				displayname = "Audit Score (%)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Overall_Result
			(
				type = picklist
				displayname = "Overall Result"
				values = {"Accessible","Partially Accessible","Not Accessible"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Failed_Items
			(
				type = number
				displayname = "Failed Items"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Evidence_Photo
			(
    			type = image
				displayname = "Evidence Photo"
				source  = file
				aspect ratio = original
				camera = primary
	 			row = 1
	 			column = 1   
				width = medium
			)
			Observations
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Audit_Status
			(
				type = picklist
				displayname = "Audit Status"
				values = {"Draft","Submitted","Reviewed"}
				initial value = "Submitted"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Barrier_Report
		{
			displayname = "Barrier Report"
			success message = "Thank you! Your barrier report has been submitted."
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Report_Reference
			(
    			type = text
				displayname = "Report Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reporter_Name
			(
    			type = text
				displayname = "Reporter Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reporter_Email
			(
    			type = email
				displayname = "Reporter Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reporter_Type
			(
				type = radiobuttons
				displayname = "Reporter Type"
				values = {"Student","Staff","Visitor"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Building
			(
				type = picklist	
				values  = Campus_Building.ID
    			displayformat = [Building_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Facility
			(
				type = picklist	
				values  = Campus_Facility.ID
    			displayformat = [Facility_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Barrier_Type
			(
				type = picklist
				displayname = "Barrier Type"
				values = {"Blocked Ramp","Lift Out of Service","Missing Handrail","Obstructed Pathway","Missing Signage","Damaged Tactile Paving","Inaccessible Restroom","Parking Misuse","Uneven Surface","Transport Boarding Issue","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Description
			(
    			type = textarea
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Barrier_Photo
			(
    			type = image
				displayname = "Barrier Photo"
				source  = file
				aspect ratio = original
				camera = primary
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				values = {"Critical","High","Medium","Low"}
				initial value = "Medium"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				values = {"Submitted","Under Review","Approved","Rejected","Assigned","Work in Progress","Awaiting Verification","Rework Required","Verified","Closed"}
				initial value = "Submitted"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Source
			(
				type = picklist
				values = {"Community Report","Audit Finding"}
				initial value = "Community Report"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reported_On
			(
    			type = date
				displayname = "Reported On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Target_Date
			(
    			type = date
				displayname = "Target Resolution Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Recurring
			(
				type = picklist
				displayname = "Recurring Barrier"
				values = {"No","Yes"}
				initial value = "No"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recurrence_Count
			(
				type = number
				displayname = "Similar Reports (60 days)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Keywords
			(
    			type = textarea
				displayname = "AI Keywords"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Sentiment
			(
    			type = text
				displayname = "AI Sentiment"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalation_Level
			(
				type = number
				displayname = "Escalation Level"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cliq_Status
			(
    			type = text
				displayname = "Cliq Alert Status"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Closed_On
			(
    			type = date
				displayname = "Closed On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Days_To_Resolve
			(
				type = number
				displayname = "Days to Resolve"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Campus_Building
		{
			displayname = "Campus Building"
			success message = "Building saved"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Building_Name
			(
    			type = text
				displayname = "Building Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Building_Code
			(
    			type = text
				displayname = "Building Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Building_Type
			(
				type = picklist
				displayname = "Building Type"
				values = {"Academic","Administrative","Library","Cafeteria","Innovation","Recreation","Sports","Transport"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Floors
			(
				type = number
				displayname = "No. of Floors"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Building_Photo
			(
    			type = image
				displayname = "Building Photo"
				source  = file
				aspect ratio = original
