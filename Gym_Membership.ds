 application "Vehicle Service Request Form"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form services
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			sE
			(
				type = section
				displayname = "Section A — Owner Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Owner_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Vehicle_Registration_Number
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Vehicle_Type
			(
				type = picklist
				maxchar = 100
				values = {"Four Wheeler","Two Wheeler","Hatchback"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section_B
			(
				type = section
				displayname = "Section B — Contact Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
    			allowedcountries={in}
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Pickup_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_c
			(
				type = section
				displayname = "Section C — Vehicle & Issue Details"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Odometer_Reading
			(
				type = number
				initial value = 1
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Service_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Breakdown Repair","General","Full Service"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Additional_Services_Requested
			(
				type = list	
				values = {"Car Wash","Interior Cleaning","Tyre Rotation"}
				height = 60px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Issue_Description
			(
    			type = textarea
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section_D_Scheduling_Authorization
			(
				type = section
				displayname = "Section D — Scheduling & Authorization"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Preferred_Service_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Preferred_Dropoff_Time
			(
    			type = time
				displayname = "Preferred Dropoff Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Authorize_Estimate_And_Repair
			(
				type = checkboxes	
				values = {"I hereby agree the policy of services"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Requires_Pickup_Drop_Service
			(
    			type = checkbox
				initial value = false
	 			row = 5
	 			column = 1   
				width = medium
			)
			Service_Center_Guidelines_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 5
	 			column = 1   
				width = medium
			)
			Insurance_Policy_Portal_URL
			(
    			type = url
				enable  linkname
	 			row = 5
	 			column = 1   
				width = medium
			)
			Vehicle_Damage_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Service_Discount_Percent
			(
    			type = percentage
	 			row = 5
	 			column = 1   
				width = medium
			)
			Estimated_Service_Cost
			(
				type = INR
				format = commadotindian
	 			row = 5
	 			column = 1   
				width = medium
			)
			Vehicle_Age_Years
			(
				type = decimal
	 			row = 5
	 			column = 1   
				width = medium
			)
			Vehicle_Age_Years1
			(
    			type = datetime
				displayname = "Service_Request_Submitted_On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Previous_Service_History
			(
				type = grid
				Date_field
				(
    				type = date
					displayname = "Date"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Single_Line
				(
    				type = text
					displayname = "Single Line"
					width = medium
				)
				Currency
				(
					type = INR
					format = commadotindian
					width = medium
				)
	 			row = 6
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			services
			(
				type = picklist	
				values  = services.ID
    			displayformat = [Modified_Time]
				advanced field search = true
				sortorder = ascending
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Owner_Digital_Signature
			(
    			type = signature
	 			row = 8
	 			column = 1   
				width = medium
				personal data = true
			)
			Insurance_Copy_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 8
	 			column = 1   
				width = medium
			)
			Insurance_Copy_Upload1
			(
    			type = upload file
				displayname = "Insurance_Copy_Upload"
				browse = local_drive
	 			row = 8
	 			column = 1   
				width = medium
			)
			Engine_Sound_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 8
	 			column = 1   
				width = medium
			)
			Vehicle_Issue_Video
			(
    			type = video
    			duration=30
	 			row = 8
	 			column = 1   
				width = medium
			)
			Service_Request_ID
			(
    			type = autonumber
				start index = 1
	 			row = 8
	 			column = 1   
				width = medium
			)
			Net_Service_Cost_Payable
			(
				type = decimal
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Service_Cost - input.Estimated_Service_Cost * input.Service_Discount_Percent / 100
    						visibility = false
    			)
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "SVC-REQ-2026-000691"
	 			row = 8
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Requested","In Diagnosis","In Repair","Ready for Pickup","Delivered"}
			}
		}
	}
	reports
	{
		default list services_Report
		{
			displayName = "services Report"
			show all rows from services    
			(
				Owner_Name 
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Vehicle_Registration_Number
				Issue_Description
				Odometer_Reading
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Vehicle_Type
				Service_Type
				Additional_Services_Requested
				Authorize_Estimate_And_Repair
				Requires_Pickup_Drop_Service
				Service_Center_Guidelines_Display
				Insurance_Policy_Portal_URL
				Vehicle_Damage_Photo
				Service_Discount_Percent
				Estimated_Service_Cost
				Vehicle_Age_Years
				Vehicle_Age_Years1 as "Service_Request_Submitted_On"
				Previous_Service_History.Date_field as "Previous_Service_History"
				services
				Owner_Digital_Signature
				Insurance_Copy_Upload
				Insurance_Copy_Upload1 as "Insurance_Copy_Upload"
				Engine_Sound_Voice_Note
				Vehicle_Issue_Video
				Service_Request_ID
				Net_Service_Cost_Payable
				QR_Code as "QR Code"
			)
		}
		list All_Service_Requests_List
		{
			displayName = "All_Service_Requests_List"
			show all rows from services    
			(
				Owner_Name 
				Vehicle_Registration_Number
				Vehicle_Type
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading
				Service_Type
				Additional_Services_Requested
				Issue_Description
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair
			)
		}
		kanban Service_Status_Kanban
		{
			displayName = "Service_Status_Kanban"
			show all rows from services    
			(
				Owner_Name 
				Vehicle_Registration_Number
				Vehicle_Type
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading
				Service_Type
				Additional_Services_Requested
				Issue_Description
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair
			)
			options
			(
	 			display field = Vehicle_Type
	 		)
		}
		calendar Service_Schedule_Calendar
		{
			displayName = "Service_Schedule_Calendar"
			show all rows from services    
			(
				Owner_Name 
				Vehicle_Registration_Number
				Vehicle_Type
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading
				Service_Type
				Additional_Services_Requested
				Issue_Description
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair
			)
			options
			(
				display field = Preferred_Service_Date
				start date = Preferred_Service_Date
			)
		}
		map Owner_Location_Map
		{
			displayName = "Owner_Location_Map"
			show all rows from services    
			(
				Owner_Name 
				Vehicle_Registration_Number
				Vehicle_Type
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading
				Service_Type
				Additional_Services_Requested
				Issue_Description
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair
			)
			options
			(
	 			display field = Pickup_Address
	 		)
		}
		timeline Service_Activity_Timeline
		{
			displayName = "Service_Activity_Timeline"
			show all rows from services    
			(
				Owner_Name 
				Vehicle_Registration_Number
				Vehicle_Type
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Pickup_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Odometer_Reading
				Service_Type
				Additional_Services_Requested
				Issue_Description
				Preferred_Service_Date
				Preferred_Dropoff_Time as "Preferred Dropoff Time"
				Authorize_Estimate_And_Repair
			)
			filters
			(
				Preferred_Service_Date
			)
			options
			(
				display field = Preferred_Dropoff_Time
				start date = Preferred_Service_Date
			)
		}
		pivottable VehicleType_By_ServiceType_PivotCross_tabulates
		{
			displayname = "VehicleType_By_ServiceType_PivotCross-tabulates"
			based on Autoview_1786099995392_services
				show all rows from services
				(
			Owner_Name 
 			(
 				first_name as "Owner_Name"
 				prefix as "Owner_Name.Prefix"
 				last_name as "Owner_Name.Last Name"
 				suffix as "Owner_Name.Suffix"
 			)
			Vehicle_Registration_Number 
			Vehicle_Type 
			Email_Address 
				)
		}
	}
	pages
	{
		page Service_Command_Center_Page
		{
			displayname = "Service_Command_Center_Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel'\n \n\t\n\ttitle = 'Top teams this season'\n\t\n\t\ttitleColor = '#222326'\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#FF4C2F'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '90'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FF4C2F'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Wonderland'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel 4'\n \n\t\n\ttitle = 'Top teams this season'\n\t\n\t\ttitleColor = '#222326'\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginTop = '5px'\n\tcolor = '#FF4C2F'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '90'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tbgColor = '#FF4C2F'\n\n\t\twidth = 