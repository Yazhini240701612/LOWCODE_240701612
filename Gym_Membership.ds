		page Command_Center_Main_Panel
		{
			displayname = "Command_Center_Main_Panel"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Daily_Bay_Utilization_Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#0BD6B1'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#0BD6B1'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.services.Estimated_Service_Cost.sum'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"78\"\n/><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"80\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='ServiceType_Distribution_Chart_Widget'\n\n\ttype = 'Pie'\n\txtitle = 'service rate'\n\tytitle = 'year'\n\tbgColor = '#000000'\n\ttheme = 'theme1'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'services'\n\txfield = 'services.Preferred_Dropoff_Time'\n\tyfields = 'sum:Estimated_Service_Cost'\n\tyAxisInterval = '70'\n\tquickFilters = 'Service_Type'\n\tshowDataLabel = 'true'\n\tunderlyingReport = 'services_Report'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<search \n\telementName='Vehicle_Owner_Search_Bar'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'rounded'\n\tresultComponent = 'report'\n\tlinkName = 'services_Report'\n\ttarget = 'new-window'\n\tcriteriaString = 'Additional_Services_Requested == input.searchString'\n\tfontFamily = 'default'\n\tallowPublicAccess = 'true'\n\tappLinkName = 'thisapp'\n\tstyle = '4'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/><searchbutton color=\"#FFFFFF\" bgColor=\"#0072F4\" \nfontSize=\"15px\"  /></search>\n</column>\n</row><row>\n\t<column\n   \