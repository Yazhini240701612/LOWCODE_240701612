		workflow
		{
		form
		{
			On_ServiceRequest_Submit_ as "On_ServiceRequest_Submit_Workflow"
			{
				type =  form
				form = services

				record event = on add

				on validate
				{
				}

			}
			Service_Request_Confirmat as "Service Request Confirmation"
			{
				type =  form
				form = services

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											sendmail
										[
											from :zoho.adminuserid
											to :"logaprabha.gb.2024.cse@rajalakshmi.edu.in"
											subject :"Zoho Creator Email Test"
											message :"This is a test email from the Vehicle Service application."
										]
						)
					}
				}

			}
		}

		schedule
		{
			Daily_ServiceDate_Reminde as "Daily_ServiceDate_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 18:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "logaprabha.gb.2024.cse@rajalakshmi.edu.in"
							to : "logaprabha.gb.2024.cse@rajalakshmi.edu.in"
							subject : "Service Request Confirmation"
							message : "<div>Your request has successfully confirmed&nbsp;<br></div><div>Request ID: a103<br></div><div>Name:Ramesh</div>"
							attachments : view : services_Report as PDF
						)
					}
				}
			}
		}

		approval
		{
			HighCost_Repair_Approval as "HighCost_Repair_Approval"
			{
				type =  approval
				form = services
				display fields = [Owner_Name,Vehicle_Registration_Number,Vehicle_Type,Email_Address,Contact_Number,Pickup_Address,Odometer_Reading]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "logaprabha.gb.2024.cse@rajalakshmi.edu.in"
								to : approver.submitter,Email_Address,approver.all
								subject : "Approval Request"
								message : "<div>Your request has been approved.<br></div>"
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

